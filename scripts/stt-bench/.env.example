# Copy to .env (same folder) and fill in whichever providers you want to
# test -- any key left blank just skips that provider, no other config
# needed. run.mjs loads this file itself; nothing here touches your real
# kira.config.json.

# Groq (whisper-large-v3, whisper-large-v3-turbo) -- you likely already have
# this if stt.engine is "groq" in kira.config.json.
GROQ_API_KEY=

# OpenAI (whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe)
OPENAI_API_KEY=

# Deepgram (nova-3) -- console.deepgram.com, has a free trial credit
DEEPGRAM_API_KEY=

# ElevenLabs (scribe_v1) -- you likely already have this for TTS
ELEVENLABS_API_KEY=

# AssemblyAI (Universal "best" model) -- www.assemblyai.com, has a free tier
ASSEMBLYAI_API_KEY=
