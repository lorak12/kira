# Copy to .env (same folder) and fill in whichever providers you want to
# test. Edge is free and always on. ELEVENLABS_API_KEY/OPENAI_API_KEY are
# also read from ../stt-bench/.env automatically if not set here, so you
# don't need to duplicate keys you already entered for the STT bench.

ELEVENLABS_API_KEY=
# Defaults to Kira's currently configured voice (kira.config.json tts.voiceId)
ELEVENLABS_VOICE_ID=

OPENAI_API_KEY=
